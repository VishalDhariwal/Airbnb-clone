# ─── Airbnb Clone – Environment Variables ──────────────────────────────────────
# Copy this file to .env and fill in values before running docker compose.
# NEVER commit the actual .env file with real secrets.

# ── PostgreSQL ──────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_strong_password_here

# ── FastAPI Backend ─────────────────────────────────────────────────────────────
SECRET_KEY=your_jwt_secret_key_at_least_32_chars_here
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Frontend ────────────────────────────────────────────────────────────────────
# Public API URL accessible from the browser
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Azure Container Registry (populated by GitHub Actions secrets) ───────────────
# ACR_LOGIN_SERVER=yourregistry.azurecr.io
# ACR_USERNAME=yourregistry
# ACR_PASSWORD=<from Azure portal>

# ── Azure App Service FQDN (used for CORS) ──────────────────────────────────────
# AZURE_FRONTEND_FQDN=your-app.azurewebsites.net
