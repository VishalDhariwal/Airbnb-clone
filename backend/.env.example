PROJECT_NAME="Airbnb Clone API"
API_V1_STR="/api"
ENVIRONMENT="development"
ENABLE_DEMO_ACCOUNTS=true
# SECRET_KEY is required and must be at least 32 characters. Do NOT use this development placeholder in production.
SECRET_KEY="supersecretdevelopmentjwtkey1234567890"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=["http://localhost:3000"]
# PostgreSQL is the single source of truth for users, listings, bookings and host data.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/airbnb_clone"

