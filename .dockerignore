# Airbnb Clone – .dockerignore
# Reduces build context size and avoids leaking secrets

# ── Git & IDE ──────────────────────────────────────────────────────────────────
.git
.gitignore
.DS_Store
.idea
.vscode
*.swp

# ── Secrets (never bake into image) ────────────────────────────────────────────
.env
backend/.env
**/.env.local
**/.env.*.local

# ── Python artefacts ───────────────────────────────────────────────────────────
backend/.venv
backend/__pycache__
backend/**/__pycache__
backend/**/*.pyc
backend/**/*.pyo
backend/.pytest_cache
backend/pytest_cache

# ── Node artefacts ─────────────────────────────────────────────────────────────
frontend/node_modules
frontend/.next
frontend/out
frontend/.turbo

# ── Documentation & dev-only files ────────────────────────────────────────────
*.md
references/
DESIGN_SYSTEM.md
IMPLEMENTATION_PLAN.md
REFERENCES_CHECKLIST.md
